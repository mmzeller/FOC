name = "foc-heat-api"
main = "worker.js"
compatibility_date = "2026-08-09"

# Create a KV namespace, then paste its IDs here.
# Example:
# [[kv_namespaces]]
# binding = "FOC_DATA"
# id = "YOUR_KV_NAMESPACE_ID"
# preview_id = "YOUR_KV_PREVIEW_ID"

[vars]
# Set these as Worker secrets/variables in Cloudflare rather than committing secrets.
# OPENAI_MODEL = "your-supported-model"
# OPENAI_SEARCH_TOOL = "web_search_preview"
